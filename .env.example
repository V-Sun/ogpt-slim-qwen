# Copy to .env and fill in. Every var the pipeline reads is listed here.

# --- Provider selection ---
# "openai_compatible" (vLLM, SGLang, Ollama, etc.) or "azure_openai".
MODEL_PROVIDER=openai_compatible

# --- OpenAI-compatible (vLLM/SGLang/Ollama) ---
OPENAI_BASE_URL=http://localhost:8000/v1
OPENAI_API_KEY=EMPTY
MODEL_NAME=Qwen/Qwen3.6-35B-A3B
# MODEL_NAME=Qwen/Qwen3-Coder-Next   # swap in for max SWE-bench performance with native tool calling

# Optional per-role overrides (default to MODEL_NAME).
# GENERATOR_MODEL=Qwen/Qwen3-Coder-Next
# REVIEWER_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
# COMPARATOR_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct

# --- Azure path (only when MODEL_PROVIDER=azure_openai) ---
# AZURE_API_KEY=
# AZURE_API_BASE=https://your-resource.openai.azure.com/
# AZURE_DEPLOYMENT=
# AZURE_API_VERSION=2024-12-01-preview
# AZURE_REASONING_EFFORT=                 # "", "low", "medium", "high"
# ORCHESTRA_USE_RESPONSES_API=

# --- Pipeline tuning ---
ORCHESTRA_API_TIMEOUT_SECONDS=600
ORCHESTRA_PER_CALL_TIMEOUT_SECONDS=300
ORCHESTRA_PROPOSER_TIMEOUT_SECONDS=3600
ORCHESTRA_PROPOSER_CONCURRENCY=10
ORCHESTRA_TASK_CONCURRENCY=1
ORCHESTRA_CRITIC_MAX_OUTPUT_TOKENS=6144
ORCHESTRA_COMPARATOR_MAX_OUTPUT_TOKENS=8192
ORCHESTRA_PROPOSER_COST_LIMIT=1000000
ORCHESTRA_LITELLM_RETRIES=0

# Mini-swe-agent: which base YAML to merge proposer overrides on top of.
# Defaults: swebench_backticks (when Azure reasoning is on) or swebench (otherwise).
# ORCHESTRA_PROPOSER_BASE_CONFIG=swebench

# Optional: deep-merge a YAML overlay onto the proposer base config. Path is
# relative to repo root unless absolute. Use to layer extra agent/model/
# environment settings without code changes. configs/qwen_local.yaml is a
# ready-made overlay with Qwen sampling defaults.
# ORCHESTRA_PROPOSER_CONFIG_OVERLAY=configs/qwen_local.yaml

# Mini-swe-agent environment class. "docker" (default), "singularity", or "local".
# Set to "singularity" on HPC clusters that use Apptainer/Singularity instead
# of Docker (e.g., MIT ORCD). When non-docker, all Docker shell-outs in
# orchestra/proposers.py (image pre-pull, container cleanup, image rmi) are
# skipped automatically.
# ORCHESTRA_ENVIRONMENT_CLASS=docker

# Free the per-instance Docker image once all proposers for that task finish
# (containerd lives on /, so images can fill the disk quickly).
# Ignored when ORCHESTRA_ENVIRONMENT_CLASS != docker.
ORCHESTRA_RMI_AFTER_TASK=1

# Dataset selection (defaults to SWE-bench Verified test split).
# SWEBENCH_DATASET=princeton-nlp/SWE-Bench_Verified
# SWEBENCH_SPLIT=test
